# Managed by Ansible (zenika.training.haproxy_lb) - do not edit by hand.
global
    log /dev/log local0
    maxconn 4000
    daemon

defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    timeout connect 10s
    timeout client  1m
    timeout server  1m

{% if haproxy_lb_stats_enabled %}
listen stats
    bind *:{{ haproxy_lb_stats_port }}
    mode http
    stats enable
    stats uri /
    stats refresh 10s
{% endif %}

# Kubernetes API server
frontend openshift-api-server
    bind *:{{ haproxy_lb_api_port }}
    default_backend openshift-api-server

backend openshift-api-server
    balance roundrobin
    option tcp-check
{% if haproxy_lb_bootstrap_enabled %}
    server {{ haproxy_lb_bootstrap_name }} {{ haproxy_lb_bootstrap_ip }}:{{ haproxy_lb_api_port }} check
{% endif %}
{% for host in haproxy_lb_control_plane_hosts %}
    server {{ host.name }} {{ host.ip }}:{{ haproxy_lb_api_port }} check
{% endfor %}

# Machine Config Server
frontend machine-config-server
    bind *:{{ haproxy_lb_machine_config_port }}
    default_backend machine-config-server

backend machine-config-server
    balance roundrobin
    option tcp-check
{% if haproxy_lb_bootstrap_enabled %}
    server {{ haproxy_lb_bootstrap_name }} {{ haproxy_lb_bootstrap_ip }}:{{ haproxy_lb_machine_config_port }} check
{% endif %}
{% for host in haproxy_lb_control_plane_hosts %}
    server {{ host.name }} {{ host.ip }}:{{ haproxy_lb_machine_config_port }} check
{% endfor %}

# Ingress - HTTP
frontend ingress-http
    bind *:{{ haproxy_lb_http_port }}
    default_backend ingress-http

backend ingress-http
    balance source
{% for host in haproxy_lb_control_plane_hosts %}
    server {{ host.name }} {{ host.ip }}:{{ haproxy_lb_http_port }} check
{% endfor %}

# Ingress - HTTPS
frontend ingress-https
    bind *:{{ haproxy_lb_https_port }}
    default_backend ingress-https

backend ingress-https
    balance source
{% for host in haproxy_lb_control_plane_hosts %}
    server {{ host.name }} {{ host.ip }}:{{ haproxy_lb_https_port }} check
{% endfor %}
