---
oc_coreos_ocp_ip: {{ _ocp_inventory_cluster.ip | default('# RENSEIGNER ICI') }}
libvirt_kvm_mac: "{{ _ocp_inventory_cluster.mac | default('52:54:00:xx:xx:xx') }}"
{% if _ocp_inventory_cluster.metallb_ip_ranges is defined %}
metallb_ip_ranges:
{% for range in _ocp_inventory_cluster.metallb_ip_ranges %}
  - "{{ range }}"
{% endfor %}
{% endif %}
