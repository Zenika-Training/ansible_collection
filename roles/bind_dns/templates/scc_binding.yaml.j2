---
# Grants anyuid SCC so that ubuntu/bind9 (root-based image) can run in OpenShift.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: bind-dns-anyuid-{{ bind_dns_namespace }}
subjects:
  - kind: ServiceAccount
    name: {{ bind_dns_service_account }}
    namespace: {{ bind_dns_namespace }}
roleRef:
  kind: ClusterRole
  name: system:openshift:scc:anyuid
  apiGroup: rbac.authorization.k8s.io
