---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: external-dns
  namespace: {{ external_dns_namespace }}
  labels:
    app: external-dns
spec:
  replicas: 1
  selector:
    matchLabels:
      app: external-dns
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: external-dns
    spec:
      serviceAccountName: {{ external_dns_service_account }}
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: external-dns
          image: {{ external_dns_image }}
          args:
            - --log-level={{ external_dns_log_level }}
            - --source=gateway-httproute
            - --provider=rfc2136
            - --rfc2136-host={{ external_dns_rfc2136_host }}
            - --rfc2136-port={{ external_dns_rfc2136_port }}
            - --rfc2136-zone={{ external_dns_rfc2136_zone }}
            - --rfc2136-tsig-keyname={{ external_dns_rfc2136_tsig_keyname }}
            - --rfc2136-tsig-secret=$(RFC2136_TSIG_SECRET)
            - --rfc2136-tsig-secret-alg={{ external_dns_rfc2136_tsig_alg }}
            - --domain-filter={{ external_dns_domain_filter }}
            - --registry=txt
            - --txt-owner-id={{ external_dns_txt_owner_id }}
            - --interval=30s
          env:
            - name: RFC2136_TSIG_SECRET
              valueFrom:
                secretKeyRef:
                  name: {{ external_dns_tsig_secret_name }}
                  key: secret
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
